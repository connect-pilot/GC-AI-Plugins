# Copy to .env for local dev. In production, set these in Render's dashboard.
PORT=8787
NODE_ENV=development
PUBLIC_URL=http://localhost:8787

# Local dev only — skips sign-in. Refused when NODE_ENV=production.
AUTH_DISABLED=true

# --- Sign-in with Google (recommended) ---
# Google Cloud → APIs & Services → Credentials → OAuth client (Web application).
# Authorized redirect URIs: <PUBLIC_URL>/oauth/callback and <PUBLIC_URL>/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Encrypts every sign-in token and download link (nothing stored): openssl rand -hex 32
OAUTH_SECRET=
# Who may sign in (Google Workspace domain and/or individual addresses)
ALLOWED_EMAIL_DOMAINS=
ALLOWED_EMAILS=
# GOOGLE_SIGN_IN=false keeps the shared access key and uses Google only for "Connect Gmail"
# GOOGLE_SIGN_IN=false
# ACCESS_TOKEN_MINUTES=60
# REFRESH_TOKEN_DAYS=30

# --- Fallback: shared access key (only when Google sign-in is off) ---
# Connector URL becomes  <PUBLIC_URL>/mcp/<MCP_ACCESS_KEY>  (or send Authorization: Bearer <key>)
MCP_ACCESS_KEY=
ACCESS_KEY_USER=joe@connectpilot.ai
# Max /mcp requests per minute per client IP
RATE_LIMIT_PER_MIN=120

# Comma-separated plugin ids to enable (blank = all): ping, resume-builder, gmail
ENABLED_PLUGINS=

# --- Resume Builder branding (letterhead, footer, client email) ---
COMPANY_NAME=GoldCoast Search Group
COMPANY_PHONE=
COMPANY_WEBSITE=
# Consultant emails offered for the letterhead (comma-separated)
CONSULTANT_EMAILS=
# File names: "<prefix> - Last, First.pdf"
RESUME_FILE_PREFIX=GoldCoast
# Optional: a different letterhead logo (PNG/JPEG path). Default: assets/gc-logo.png
# COMPANY_LOGO_PATH=

# --- Resume Builder storage ---
# Where builds are saved (one JSON file each). Default locally: .data/resumes; production: memory only unless set.
# RESUME_DATA_DIR=/var/data/resumes
# RESUME_RETENTION_DAYS=180
