{
  "name": "gc-ai-plugins",
  "version": "0.1.0",
  "private": true,
  "description": "GoldCoast Search Group AI plugins served over a vendor-neutral MCP server",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json && vite build --config vite.resume-builder.config.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "inspect": "npx -y @modelcontextprotocol/inspector@latest",
    "sample": "tsx scripts/render-sample.ts",
    "smoke": "tsx scripts/smoke.ts",
    "harness": "vite --config scripts/harness/vite.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.1.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "docx": "^9.16.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.4",
    "mammoth": "^1.13.0",
    "mupdf": "1.28.1",
    "pdfkit": "^0.21.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "@types/pdfkit": "^0.17.7",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^3.2.0"
  }
}
